# Copy this file to secrets.properties for a local release build.
# In CI, provide the same values as environment variables instead.
APP_METRICA_API_KEY=your_appmetrica_api_key

# Release signing can be configured here through environment variables,
# while existing local builds may continue using ignored keystore.properties.
# VOLTHOME_KEYSTORE_PATH=/absolute/path/to/upload_key
# VOLTHOME_KEYSTORE_PASSWORD=change_me
# VOLTHOME_KEY_ALIAS=upload_key
# VOLTHOME_KEY_PASSWORD=change_me
